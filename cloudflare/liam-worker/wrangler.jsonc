{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "icvacation-liam",
  "account_id": "0228e3fe174bbc185f30b1d4eaf5f166",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "liam-kb"
    }
  ],
  "d1_databases": [
    {
      "binding": "liam_data",
      "database_name": "liam-data",
      "database_id": "e2b420db-824c-43a2-974c-013159ee0446"
    }
  ],
  "r2_buckets": [
    {
      "bucket_name": "liam-corpus",
      "binding": "liam_corpus"
    }
  ],
  "queues": {
    "producers": [
      {
        "queue": "liam-post-conversation",
        "binding": "liam_post_conversation"
      }
    ],
    "consumers": [
      {
        "queue": "liam-post-conversation"
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LiamAgent",
        "class_name": "LiamAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LiamAgent"]
    }
  ],
  "vars": {
    "AI_GATEWAY_ID": "default"
  },
  "observability": {
    "enabled": true
  }
}

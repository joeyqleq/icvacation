{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "icvacation-liam",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "liam-kb"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LiamAgent",
        "class_name": "LiamAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LiamAgent"]
    }
  ],
  "vars": {
    "AI_GATEWAY_ID": "default"
  },
  "observability": {
    "enabled": true
  }
}
